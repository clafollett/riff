# The living Inn lives OUTSIDE this repo (~/.lafollett-bnb by default) —
# it is data, not source, and it must survive this folder being moved.
# These two only exist if you deliberately point INN_HOME back in here
# for development; they are ignored so village history never mixes with
# source history.
/world/
/var/

# Machine-specific. Holds absolute paths; run `node scripts/init.ts` instead.
/inn.config.json

# Playwright output — traces, screenshots and HTML reports are build artefacts.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# the operator's Claude token
docker/.env
