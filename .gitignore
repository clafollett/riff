node_modules/
dist/
*.log
.env
.env.*
!.env.example

# Companies live OUTSIDE this repo (~/.helmsted by default) — they are data,
# not source, and they must survive this folder being moved or deleted. These
# two only exist if you deliberately point HELMSTED_ROOT back in here while
# developing; they are ignored so a company's history never mixes with the
# source history.
/world/
/var/

# Playwright output — traces, screenshots and HTML reports are build artefacts.
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# the operator's Claude token
docker/.env
