# Copy to docker/.env and fill in. That file is gitignored; this one is not.
#
# The token is yours to generate and yours alone to see:
#
#     claude setup-token
#
# It is long-lived and carries your subscription. Anything with a shell in the
# factory container can read it — which is exactly why the factory has no route
# to the internet except the allowlist proxy.

CLAUDE_CODE_OAUTH_TOKEN=

# Where every company lives. Defaults to ~/.helmsted — the SAME directory the
# host uses, so the container sees the companies you already have. Set this
# only if you want the container to work against a different installation.
HELMSTED_DATA=

# Only used when the installation is empty, to name the first company.
# After that, found companies from the console.
HELMSTED_COMPANY=
HELMSTED_BUSINESS=
HELMSTED_CHAIR=
HELMSTED_CEO=

# Where the Desk is published on your machine (loopback only).
PORT=4173
