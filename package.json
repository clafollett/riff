{
  "name": "helmsted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A company founds itself: a CEO agent hires its own staff and builds real things, under rules enforced in code.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "tsgo --noEmit && tsgo --noEmit -p desk/tsconfig.json && tsgo --noEmit -p e2e/tsconfig.json",
    "test": "node --test test/**/*.test.ts",
    "init": "node scripts/init.ts",
    "tick": "node scripts/tick.ts",
    "status": "node scripts/status.ts",
    "desk": "node src/gateway/server.ts",
    "desk:build": "vite build --config desk/vite.config.ts",
    "desk:dev": "vite --config desk/vite.config.ts",
    "test:ui": "npm run desk:build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.243",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  }
}
